---
import '../styles/global.css';
import {
  cvFiles,
  defaultLocale,
  localeMeta,
  portfolioContent,
  siteOrigin,
  supportedLocales,
  type Locale
} from '../lib/portfolio-content';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const content = portfolioContent[locale];
const meta = localeMeta[locale];
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${baseUrl}${path.replace(/^\/+/, '')}`;
const absoluteUrl = (path = '') => new URL(`${baseUrl}${path}`.replace(/\/{2,}/g, '/'), siteOrigin).toString();
const localePath = locale === defaultLocale ? '' : `${locale}/`;
const canonicalUrl = absoluteUrl(localePath);
const alternateLinks = supportedLocales.map((code) => ({
  code,
  href: absoluteUrl(code === defaultLocale ? '' : `${code}/`),
  label: localeMeta[code].label,
  shortLabel: localeMeta[code].shortLabel,
  active: code === locale
}));
const heroImage = withBase('systems-ledger-hero.webp');
const ogImage = absoluteUrl('og-image.jpg');
const ogImageAlt = `${content.localizedName ?? content.name} — ${content.jobTitle}`;
const cvHref = {
  en: withBase(cvFiles.en),
  ru: withBase(cvFiles.ru)
} satisfies Record<Locale, string>;
const heroProof = content.heroProofIndexes.map((index) => content.metrics[index]);
const localizedActions = content.hero.actions.map((link) => ({
  ...link,
  href: link.download ? withBase(link.href) : link.href
}));
const localizedContactLinks = content.sections.contact.links.map((link) => ({
  ...link,
  href: link.download ? withBase(link.href) : link.href
}));
const personJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: content.name,
  alternateName: content.localizedName,
  url: canonicalUrl,
  image: ogImage,
  jobTitle: content.jobTitle,
  email: 'mailto:basl.alshayeb@gmail.com',
  sameAs: ['https://github.com/Basselalshayeb2', 'https://linkedin.com/in/bassel-alshayeb', 'https://t.me/bassel_alshayeb'],
  knowsAbout: content.schemaKnowsAbout
});
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{content.pageTitle}</title>
    <meta name="description" content={content.pageDescription} />
    <meta name="author" content={content.author} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#0d1011" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateLinks.map((link) => <link rel="alternate" hreflang={link.code} href={link.href} />)
    }
    <link rel="alternate" hreflang="x-default" href={alternateLinks.find((link) => link.code === defaultLocale)?.href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:wght@500;600;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap"
    />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <meta property="og:title" content={content.pageTitle} />
    <meta property="og:description" content={content.pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={content.siteName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={meta.ogLocale} />
    {
      alternateLinks
        .filter((link) => link.code !== locale)
        .map((link) => <meta property="og:locale:alternate" content={localeMeta[link.code].ogLocale} />)
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={content.pageTitle} />
    <meta name="twitter:description" content={content.pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" is:inline set:html={personJsonLd} />
  </head>
  <body>
    <main>
      <section class="hero-section">
        <div class="systems-ambient" style={`--systems-art: url("${heroImage}")`} aria-hidden="true"></div>

        <nav class="site-nav shell" aria-label={content.nav.ariaLabel}>
          <a href={withBase(localePath)} class="brand-lockup">
            <span>{content.hero.identityLine}</span>
            <small>{content.nav.brandRole}</small>
          </a>
          <div class="nav-links">
            {
              content.nav.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))
            }
          </div>
          <div class="nav-controls">
            <div class="language-switch" aria-label={content.nav.languageSwitcherLabel}>
              {
                alternateLinks.map((link) => (
                  <a
                    class:list={['language-option', { 'is-active': link.active }]}
                    href={withBase(link.code === defaultLocale ? '' : `${link.code}/`)}
                    aria-label={link.label}
                    aria-current={link.active ? 'page' : undefined}
                  >
                    {link.shortLabel}
                  </a>
                ))
              }
            </div>
            <a class="nav-cta" href={cvHref[locale]} download={cvFiles[locale]} aria-label={content.nav.cvAriaLabel}>{content.nav.cvLabel}</a>
          </div>
        </nav>

        <div id="top" class="hero-grid shell">
          <div class="hero-copy reveal">
            <p class="identity-line">{content.hero.identityLine}</p>
            <h1>{content.hero.title}</h1>
            <p class="hero-lead">{content.hero.lead}</p>
            <p class="hero-support">{content.hero.support}</p>

            <div class="hero-actions" aria-label={content.hero.actionsAriaLabel}>
              {
                localizedActions.map((link) => (
                  <a
                    class:list={['action-link', `action-link--${link.variant ?? 'secondary'}`]}
                    href={link.href}
                    aria-label={link.ariaLabel}
                    download={link.download}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noreferrer' : undefined}
                  >
                    {link.label}
                  </a>
                ))
              }
            </div>

            <dl class="proof-strip" aria-label={content.hero.proofAriaLabel}>
              {
                heroProof.map((metric) => (
                  <div>
                    <dt>{metric.value}</dt>
                    <dd>{metric.label}</dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <aside class="ownership-panel reveal reveal-delay-1" aria-labelledby="ownership-title">
            <div class="panel-heading">
              <h2 id="ownership-title">{content.ownership.title}</h2>
              <p>{content.ownership.intro}</p>
            </div>
            <div class="ownership-list">
              {
                content.ownership.rows.map((row) => (
                  <article>
                    <p class="ownership-system">{row.system}</p>
                    <h3>{row.scope}</h3>
                    <p>{row.proof}</p>
                  </article>
                ))
              }
            </div>
          </aside>
        </div>
      </section>

      <section id="experience" class="shell border-t border-[var(--rule)] py-14 sm:py-20">
        <div class="grid gap-7 lg:grid-cols-[180px_1fr]">
          <p class="section-label">{content.sections.experience.label}</p>
          <div>
            <h2 class="section-heading">
              {content.sections.experience.heading}
            </h2>
            <div class="mt-10 grid gap-4">
              {
                content.sections.experience.items.map((item) => (
                  <article class="experience-row">
                    <div>
                      <h3 class="text-lg font-bold text-[#fff8df]">{item.company}</h3>
                      <p class="mt-1 font-mono text-[0.72rem] font-bold uppercase text-[var(--quiet)]">{item.period}</p>
                      <p class="mt-3 text-sm font-semibold text-[var(--muted)]">{item.role}</p>
                    </div>
                    <p class="text-base leading-7 text-[var(--muted)]">{item.summary}</p>
                    <p class="font-mono text-xs font-bold leading-6 text-[var(--brass)]">{item.stack}</p>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section id="project" class="shell border-t border-[var(--rule)] py-14 sm:py-20">
        <div class="grid gap-7 lg:grid-cols-[180px_1fr]">
          <p class="section-label">{content.sections.project.label}</p>
          <div>
            <h2 class="section-heading">
              {content.sections.project.heading}
            </h2>
            <div class="mt-9 grid gap-5 lg:grid-cols-[0.85fr_1.15fr]">
              <div class="panel rounded-lg border-[var(--rule-strong)] p-6 font-mono text-sm font-bold leading-7 text-[var(--ink)]">
                {content.sections.project.flow}
              </div>
              <div class="grid gap-4 text-base leading-7 text-[var(--muted)]">
                {
                  content.sections.project.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="skills" class="shell border-t border-[var(--rule)] py-14 sm:py-20">
        <div class="grid gap-7 lg:grid-cols-[180px_1fr]">
          <p class="section-label">{content.sections.skills.label}</p>
          <div>
            <h2 class="section-heading">
              {content.sections.skills.heading}
            </h2>
            <p class="mt-5 max-w-3xl text-base leading-7 text-[var(--muted)]">
              {content.sections.skills.intro}
            </p>
            <div class="mt-9 grid gap-5 md:grid-cols-2 xl:grid-cols-5">
              {
                content.sections.skills.groups.map((group) => (
                  <article class="border-t-2 border-[var(--brass)] pt-4">
                    <h3 class="font-mono text-sm font-extrabold uppercase text-[#fff8df]">{group.title}</h3>
                    <p class="mt-4 text-sm leading-7 text-[var(--muted)]">{group.items.join(', ')}</p>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section id="contact" class="shell border-t border-[var(--rule)] py-14 sm:py-20">
        <div class="contact-band">
          <div>
            <p class="font-mono text-xs font-extrabold uppercase">{content.sections.contact.label}</p>
            <h2>{content.sections.contact.heading}</h2>
          </div>
          <address>
            {
              localizedContactLinks.map((link) => (
                <a
                  class="font-mono text-sm font-extrabold underline-offset-4 hover:underline"
                  href={link.href}
                  download={link.download}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noreferrer' : undefined}
                >
                  {link.label}
                </a>
              ))
            }
          </address>
        </div>
      </section>
    </main>
  </body>
</html>
